# Terraform provider binaries and plugins (huge, never commit these)
**/.terraform/
# Terraform state files
*.tfstate
*.tfstate.*
**/*.tfstate
**/*.tfstate.*
*.tfplan

# Crash log files
crash.log
crash.*.log

# Sensitive variable files
*.tfvars
*.tfvars.json
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Lock file IS committed (it pins provider versions)
# .terraform.lock.hcl  <-- do NOT ignore this one

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.code-workspace

# Lambda build artifacts
*.zip
**/*.zip
lambda/create-schema.zip
terraform/authorizer.zip
terraform/notify_success.zip

# Dynamic per-tenant terraform files (must never be committed)
terraform/tenant_*.tf
!terraform/tenant_*.tf.example

# Local screenshots and adhoc notes
*.png
response.json
terraform/response.json

# Web Frontend
web/node_modules/
web/dist/
web/.env
web/.env.local
web/.env.*.local
!web/.env.example

# Node Packages & SDKs
**/node_modules/
packages/**/dist/
sdk/**/dist/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/


