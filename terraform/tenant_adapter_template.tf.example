# ==============================================================================
# TryBase: Workload Adapter Boilerplate Template
#
# Use this template when contributing a new AI Agent, Automation, or Service
# adapter to the open-source TryBase platform (e.g. OpenClaw, Flowise, Langflow).
#
# How to test your adapter manually:
# 1. Copy this file:
#      cp tenant_adapter_template.tf.example tenant_myagent.tf
# 2. Fill in your container image, port, and environment variables below.
# 3. Test deploy:
#      terraform apply -target=module.myagent
# 4. Verify in browser:
#      https://myagent.<your-base-domain>
# 5. Clean up:
#      terraform destroy -target=module.myagent
# ==============================================================================

module "myagent" {
  source = "./modules/generic-workload"

  # ----------------------------------------------------------------------------
  # 1. Service Identity & Routing
  # ----------------------------------------------------------------------------
  service_name = "myagent"
  subdomain    = "myagent"
  domain_name  = var.base_domain

  # ----------------------------------------------------------------------------
  # 2. Container Specification
  # ----------------------------------------------------------------------------
  # Public Docker Hub or ECR Public container image
  container_image   = "your-org/your-agent:latest"
  container_port    = 8000
  health_check_path = "/health" # Native route returning 200 (e.g. /health, /api/health)

  # Fargate Compute Allocation (Task sum constraint: CPU >= 256, Memory >= 512)
  cpu    = 512  # 0.5 vCPU
  memory = 1024 # 1024 MiB (1 GB)

  # ----------------------------------------------------------------------------
  # 3. Platform Add-on Flags (Zero-Cost In-Task Services)
  # ----------------------------------------------------------------------------
  # Injects a private redis:alpine sidecar on 127.0.0.1:6379 ($0 added cloud cost)
  enable_redis = false

  # Injects an IAM Task Role with keyless link-local STS access to Amazon Bedrock (169.254.170.2)
  enable_bedrock = false

  # ----------------------------------------------------------------------------
  # 4. Environment Variables
  # ----------------------------------------------------------------------------
  environment_variables = {
    PORT        = "8000"
    ENVIRONMENT = "production"

    # Optional: Connect to in-task Redis (when enable_redis = true)
    # REDIS_HOST = "127.0.0.1"
    # REDIS_PORT = "6379"

    # Optional: Connect to tenant-scoped PostgreSQL on shared RDS
    # DB_HOST     = aws_db_instance.main.address
    # DB_PORT     = "5432"
    # DB_DATABASE = "db_myagent"
    # DB_USERNAME = "usr_myagent"
    # DB_PASSWORD = "YourSecurePasswordHere!"
  }

  # ----------------------------------------------------------------------------
  # 5. Infrastructure Bindings (Standard TryBase Fleet Wiring)
  # ----------------------------------------------------------------------------
  vpc_id                     = module.vpc.vpc_id
  private_subnet_ids         = module.vpc.private_subnets
  ecs_cluster_name           = aws_ecs_cluster.main.name
  alb_listener_arn           = aws_lb_listener.https.arn
  alb_security_group_id      = aws_security_group.alb.id
  alb_listener_rule_priority = 450 # Unique integer between 100 and 50000
}
